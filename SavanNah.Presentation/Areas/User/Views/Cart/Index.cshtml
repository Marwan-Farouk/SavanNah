@model IEnumerable<CartItemVm>

@{
    var cartItems = Model?.ToList() ?? new List<CartItemVm>();
    var totalQuantity = cartItems.Sum(item => item.count);
    var subtotal = cartItems.Sum(item => item.Product.Price * item.count);
    var cartTotal = cartItems.Sum(item =>
        item.Product.Price * (1 - item.Product.Discount / 100m) * item.count);
    var totalDiscount = subtotal - cartTotal;
    var updateUrl = Url.Action("Update", "Cart", new { area = "User" });
    var removeUrl = Url.Action("RemoveItem", "Cart", new { area = "User" });
    ViewData["Title"] = "Shopping Cart";
}

<style>
    .update-cart-btn {
        max-width: 4.75rem; min-width: 0; opacity: 1; overflow: hidden;
        flex: 0 0 auto; transition: 0.2s;
    }
    .update-cart-btn.is-hidden {
        max-width: 0; opacity: 0; padding-left: 0; padding-right: 0;
        border-left-width: 0; border-right-width: 0; pointer-events: none;
    }
    .cart-count-group { width: fit-content; flex-wrap: nowrap; white-space: nowrap; }
    .cart-count-input { flex: 0 0 4.5rem !important; width: 4.5rem !important; }
</style>

<div class="sv-page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item">
                    <a asp-area="User" asp-controller="Product" asp-action="Index">Products</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
            </ol>
        </nav>
        <h1 class="sv-page-title">Shopping Cart</h1>
        <p style="color: var(--sv-light-text-muted); font-size: 14px; margin: 0.25rem 0 0;">
            @totalQuantity item@(totalQuantity == 1 ? "" : "s") in your cart
        </p>
    </div>
    <a asp-area="User" asp-controller="Product" asp-action="Index" class="btn-sv-secondary" style="height: 40px; font-size: 12px;">
        <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
        Continue Shopping
    </a>
</div>

@if (cartItems.Count == 0)
{
    <div style="text-align: center; padding: 4rem 2rem; border: 1px solid var(--sv-light-border); background: var(--sv-light-surface);">
        <span class="material-symbols-outlined" style="font-size: 48px; color: var(--sv-light-text-dim); margin-bottom: 1rem; display: block;">remove_shopping_cart</span>
        <h3 style="font-family: var(--sv-font-display); font-weight: 600; margin-bottom: 0.5rem;">Your cart is empty</h3>
        <p style="color: var(--sv-light-text-muted); font-size: 14px; margin-bottom: 1.5rem;">Browse our products and add something you like to your cart.</p>
        <a asp-area="User" asp-controller="Product" asp-action="Index" class="btn-sv-primary" style="height: 44px;">
            <span class="material-symbols-outlined" style="font-size: 18px;">shopping_bag</span>
            Browse Products
        </a>
    </div>
}
else
{
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            @for(int i=0; i< Model!.Count();i++)
            {
                var item = cartItems[i];
                var product = item.Product;
                var hasDiscount = product.Discount > 0;
                var unitPrice = product.Price * (1 - product.Discount / 100m);
                var lineTotal = unitPrice * item.count;

                <article class="card mb-3 cart-item" data-product-id="@product.Id" data-update-url="@updateUrl" data-remove-url="@removeUrl"
                         style="border: 1px solid var(--sv-light-border) !important; background: var(--sv-light-surface) !important;">
                    <div class="card-body p-3 p-md-4">
                        <div class="row g-3 align-items-center">
                            <div class="col-4 col-sm-3 col-md-2">
                                <a asp-area="User" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                    @if (!string.IsNullOrWhiteSpace(product.Image))
                                    {
                                        <img src="~/@product.Image" alt="@product.Name" style="width: 100%; height: 100px; object-fit: cover;"/>
                                    }
                                    else
                                    {
                                        <img src="~/images/Products/Product_placeholder.avif" alt="@product.Name" style="width: 100%; height: 100px; object-fit: cover;"/>
                                    }
                                </a>
                            </div>
                            <div class="col-8 col-sm-9 col-md-10">
                                <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
                                    <div>
                                        <span class="sv-label-micro" style="color: var(--sv-light-text-dim); font-size: 10px;">Product #@product.Id</span>
                                        <h2 style="font-family: var(--sv-font-display); font-size: 16px; font-weight: 600; margin: 0.25rem 0 0;">
                                            <a asp-area="User" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                               style="color: var(--sv-light-text); text-decoration: none;">@product.Name</a>
                                        </h2>
                                        @if (product.Brand is not null)
                                        {
                                            <span style="font-size: 13px; color: var(--sv-light-text-muted);">@product.Brand.Name</span>
                                        }
                                    </div>
                                    <div style="text-align: right;">
                                        <span style="font-size: 12px; color: var(--sv-light-text-muted); display: block;">Unit price</span>
                                        @if (hasDiscount)
                                        {
                                            <span style="text-decoration: line-through; color: var(--sv-text-dim); font-size: 13px; margin-right: 0.25rem;">@product.Price.ToString("c")</span>
                                            <span style="font-weight: 700; color: var(--sv-terracotta);">@unitPrice.ToString("c")</span>
                                            <br/><span class="badge sv-badge-discount" style="font-size: 10px; margin-top: 0.25rem;">@product.Discount.ToString("0.##")% off</span>
                                        }
                                        else
                                        {
                                            <span style="font-weight: 700;">@unitPrice.ToString("c")</span>
                                        }
                                    </div>
                                </div>
                                <div class="row g-3 mt-3 pt-3 align-items-end" style="border-top: 1px solid var(--sv-light-border);">
                                    <div class="col-sm-4">
                                        <label for="count-@product.Id" style="font-size: 12px; color: var(--sv-light-text-muted); display: block; margin-bottom: 0.25rem;">Count</label>
                                        <div class="input-group input-group-sm cart-count-group">
                                            <input type="number" id="count-@product.Id" class="form-control cart-count-input" min="1" step="1" value="@item.count" data-original-count="@item.count"/>
                                            <button type="button" class="btn btn-outline-primary btn-sm px-2 update-cart-btn is-hidden">Update</button>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <span style="font-size: 12px; color: var(--sv-light-text-muted); display: block;">Total</span>
                                        <span class="sv-price-display" style="font-size: 18px;">@lineTotal.ToString("c")</span>
                                    </div>
                                    <div class="col-sm-4 text-sm-end">
                                        <button type="button" class="btn-sv-danger remove-cart-btn" data-product-id="@product.Id" style="height: 36px; font-size: 12px;">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <div class="sticky-lg-top" style="top: 5rem;">
                <div style="background: var(--sv-light-surface); border: 1px solid var(--sv-light-border); padding: 1.5rem;">
                    <h2 style="font-family: var(--sv-font-display); font-size: 18px; font-weight: 600; margin-bottom: 1.5rem;">Order Summary</h2>

                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 14px;">
                        <span style="color: var(--sv-light-text-muted);">Products (@totalQuantity)</span>
                        <span class="sv-tabular">@subtotal.ToString("c")</span>
                    </div>

                    @if (totalDiscount > 0)
                    {
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 14px; color: var(--sv-green);">
                            <span>Discount</span>
                            <span class="sv-tabular">-@totalDiscount.ToString("c")</span>
                        </div>
                    }

                    <div style="border-top: 1px solid var(--sv-light-border); padding-top: 1rem; margin-top: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 600;">Total</span>
                        <span class="sv-price-display">@cartTotal.ToString("c")</span>
                    </div>

                    <form method="post" asp-controller="Payment" asp-action="StartPaymentSession">
                        <button type="submit" class="btn-sv-primary" style="width: 100%; height: 48px;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">credit_card</span>
                            Checkout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/Cart/index.js" asp-append-version="true"></script>
}