@{
    ViewData["Title"] = "Categories";
}
@model IEnumerable<Category>

<div class="sv-page-header">
    <div>
        <span class="sv-section-tag" style="margin-bottom: 0.25rem;">Browse</span>
        <h1 class="sv-page-title">All Categories</h1>
    </div>
</div>

@if (!Model.Any())
{
    <div style="text-align: center; padding: 4rem 2rem; border: 1px solid var(--sv-light-border); background: var(--sv-light-surface);">
        <span class="material-symbols-outlined" style="font-size: 48px; color: var(--sv-light-text-dim); margin-bottom: 1rem; display: block;">category</span>
        <h3 style="font-family: var(--sv-font-display); font-weight: 600; margin-bottom: 0.5rem;">No categories found</h3>
        <p style="color: var(--sv-light-text-muted); font-size: 14px;">Check back later for new categories.</p>
    </div>
}
else
{
    <div class="row row-cols-1 g-3">
        @foreach (var category in Model)
        {
            <div class="col">
                <div style="background: var(--sv-light-surface); border: 1px solid var(--sv-light-border); padding: 1.5rem; transition: border-color 0.2s ease;"
                     onmouseover="this.style.borderColor='var(--sv-terracotta)'" onmouseout="this.style.borderColor='var(--sv-light-border)'">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <h3 style="font-family: var(--sv-font-display); font-size: 18px; font-weight: 600; margin-bottom: 0.25rem;">@category.Name</h3>
                            <p style="color: var(--sv-light-text-muted); font-size: 14px; margin: 0; line-height: 1.5;">
                                @Html.Raw(string.IsNullOrWhiteSpace(category.Description) ? "No description available." : category.Description)
                            </p>
                        </div>
                        <button class="btn-sv-secondary show-products-btn" style="height: 36px; font-size: 11px; white-space: nowrap;"
                                data-category-id="@category.Id" data-target="products-panel-@category.Id">
                            <span class="btn-label">Show Products</span>
                            <span class="material-symbols-outlined" style="font-size: 16px;">expand_more</span>
                        </button>
                    </div>

                    <div class="products-panel collapse mt-3" id="products-panel-@category.Id">
                        <div style="border-top: 1px solid var(--sv-light-border); padding-top: 1rem;">
                            <div class="products-content" id="products-content-@category.Id">
                                <div class="text-center py-2" style="color: var(--sv-light-text-muted); font-size: 14px;">
                                    <div class="spinner-border spinner-border-sm me-2" role="status" style="color: var(--sv-terracotta);"></div>
                                    Loading products...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/Category/User/index.js"></script>
}
