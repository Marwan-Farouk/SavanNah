@{
    ViewData["Title"] = "Products";
}
@model List<Product>

<div class="sv-page-header">
    <div>
        <span class="sv-section-tag" style="margin-bottom: 0.25rem;">Catalog</span>
        <h1 class="sv-page-title">All Products</h1>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center;">
        <span class="badge sv-badge-category" style="font-size: 12px; padding: 6px 12px;">@Model.Count item@(Model.Count != 1 ? "s" : "")</span>
        <a class="btn-sv-primary" asp-area="User" asp-controller="Product" asp-action="Create" style="height: 40px; font-size: 12px;">
            <span class="material-symbols-outlined" style="font-size: 16px;">add</span>
            Add Product
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div style="text-align: center; padding: 4rem 2rem; border: 1px solid var(--sv-light-border); background: var(--sv-light-surface);">
        <span class="material-symbols-outlined" style="font-size: 48px; color: var(--sv-light-text-dim); margin-bottom: 1rem; display: block;">inventory_2</span>
        <h3 style="font-family: var(--sv-font-display); font-weight: 600; margin-bottom: 0.5rem;">No products found</h3>
        <p style="color: var(--sv-light-text-muted); font-size: 14px;">Start by adding your first product to the catalog.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4" style="--bs-gutter-x: 1.5rem; --bs-gutter-y: 2rem;">
        @foreach (var prod in Model)
        {
            var hasDiscount = prod.Discount > 0;
            var discountedPrice = prod.Price * (1 - prod.Discount / 100m);
            var categoryName = prod.CategoryProducts?.FirstOrDefault()?.Category?.Name;

            <div class="col">
                <article class="sv-product-card" style="height: 100%; display: flex; flex-direction: column;">
                    <div style="position: relative;">
                        @if (!string.IsNullOrEmpty(prod.Image))
                        {
                            <img src="~/@prod.Image" alt="@prod.Name" class="sv-card-img"/>
                        }
                        else
                        {
                            <img src="~/images/Products/Product_placeholder.avif" alt="@prod.Name" class="sv-card-img"/>
                        }
                        @if (hasDiscount)
                        {
                            <span class="sv-badge-discount" style="position: absolute; top: 12px; left: 12px; padding: 4px 8px; font-size: 11px;">
                                @prod.Discount.ToString("0.##")% OFF
                            </span>
                        }
                    </div>
                    <div class="sv-card-body" style="flex: 1; display: flex; flex-direction: column;">
                        @if (!string.IsNullOrEmpty(categoryName))
                        {
                            <div class="sv-card-category">@categoryName</div>
                        }
                        <h3 class="sv-card-title">@prod.Name</h3>

                        <div style="margin-top: 0.5rem; color: var(--sv-light-text-muted); font-size: 13px; line-height: 1.5; flex: 1;">
                            @if (!string.IsNullOrWhiteSpace(prod.Brand?.Name))
                            {
                                <span style="display: inline-flex; align-items: center; gap: 0.25rem;">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">verified</span>
                                    @prod.Brand.Name
                                </span>
                            }
                        </div>

                        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--sv-light-border);">
                            <div>
                                @if (hasDiscount)
                                {
                                    <span class="sv-card-price-old" style="font-size: 13px; margin-right: 0.35rem;">@prod.Price.ToString("c")</span>
                                    <span class="sv-card-price">@discountedPrice.ToString("c")</span>
                                }
                                else
                                {
                                    <span class="sv-card-price">@prod.Price.ToString("c")</span>
                                }
                            </div>
                            <a asp-area="User" asp-controller="Product" asp-action="Details" asp-route-id="@prod.Id"
                               class="btn-sv-ghost" style="font-size: 11px; padding: 0;">
                                View
                                <span class="material-symbols-outlined" style="font-size: 14px;">arrow_outward</span>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}