@model ProductVM
@{
    ViewData["Title"] = "Create Product";
}

<div class="sv-page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item">
                    <a asp-area="User" asp-controller="Product" asp-action="Index">Products</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
        <h1 class="sv-page-title">New Product</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div style="background: var(--sv-light-surface); border: 1px solid var(--sv-light-border);">
            <!-- Header -->
            <div style="background: var(--sv-primary); padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                <span class="material-symbols-outlined" style="font-size: 24px; color: var(--sv-text-primary);">inventory_2</span>
                <div>
                    <h2 style="font-family: var(--sv-font-display); font-size: 16px; font-weight: 600; color: var(--sv-text-primary); margin: 0;">Product Details</h2>
                    <span style="font-size: 12px; color: var(--sv-text-muted);">Fill in the information below to create a new product</span>
                </div>
            </div>

            <!-- Form Body -->
            <div style="padding: 1.5rem;">
                <form asp-area="User" asp-controller="Product" asp-action="Create" enctype="multipart/form-data" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <!-- Basic Info -->
                    <div class="sv-label-micro" style="color: var(--sv-terracotta); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">info</span>
                        Basic Information
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Name" class="form-label">
                            Product Name <span style="color: var(--sv-red);">*</span>
                        </label>
                        <input asp-for="Product.Name" id="Name" class="form-control" placeholder="e.g. Running Shoes Pro X" autocomplete="off"/>
                        <span asp-validation-for="Product.Name" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label">Description</label>
                        <textarea asp-for="Product.Description" id="Description" class="form-control" rows="3"
                                  placeholder="Write a short product description…" maxlength="1000"></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="Product.Description" class="text-danger" style="font-size: 12px;"></span>
                            <small style="color: var(--sv-light-text-dim);" id="desc-counter">0 / 1000</small>
                        </div>
                    </div>

                    <!-- Pricing -->
                    <div class="sv-label-micro" style="color: var(--sv-terracotta); margin: 1.5rem 0 1rem; display: flex; align-items: center; gap: 0.5rem;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">payments</span>
                        Pricing
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Product.Price" class="form-label">
                                Price <span style="color: var(--sv-red);">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: var(--sv-light-bg-alt); border: 1px solid var(--sv-light-border); color: var(--sv-light-text-muted);">$</span>
                                <input asp-for="Product.Price" id="Price" type="number" step="0.01" min="0.01" max="999999.99" class="form-control" placeholder="0.00"/>
                            </div>
                            <span asp-validation-for="Product.Price" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Product.Discount" class="form-label">Discount (%)</label>
                            <div class="input-group">
                                <input asp-for="@Model.Product.Discount" id="Discount" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="0"/>
                                <span class="input-group-text" style="background: var(--sv-light-bg-alt); border: 1px solid var(--sv-light-border); color: var(--sv-light-text-muted);">%</span>
                            </div>
                            <span asp-validation-for="Product.Discount" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </div>

                    <!-- Classification -->
                    <div class="sv-label-micro" style="color: var(--sv-terracotta); margin: 1.5rem 0 1rem; display: flex; align-items: center; gap: 0.5rem;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">account_tree</span>
                        Classification
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.BrandId" class="form-label">
                            Brand <span style="color: var(--sv-red);">*</span>
                        </label>
                        <select asp-for="Product.BrandId" id="BrandId" asp-items="Model.Brands" class="form-select">
                            <option value="" disabled selected>— Select a brand —</option>
                        </select>
                        <span asp-validation-for="Product.BrandId" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryIds" class="form-label">
                            Categories <span style="color: var(--sv-red);">*</span>
                        </label>
                        <select asp-for="CategoryIds" asp-items="@Model.Categories" class="form-select" id="CategoryIds" multiple></select>
                    </div>

                    <div class="mb-4">
                        <label for="Image" class="form-label">Product Image</label>
                        <input type="file" name="file" class="form-control" id="Image"/>
                    </div>

                    <!-- Actions -->
                    <div style="display: flex; gap: 0.75rem; justify-content: flex-end; padding-top: 1rem; border-top: 1px solid var(--sv-light-border);">
                        <a asp-area="User" asp-controller="Product" asp-action="Index" class="btn-sv-secondary" style="height: 40px; font-size: 12px;">
                            Cancel
                        </a>
                        <button type="submit" class="btn-sv-primary" style="height: 40px; font-size: 12px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">add</span>
                            Create Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script>
        tinymce.init({
            selector: 'textarea',
            plugins: [
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount',
            ],
            toolbar: 'undo redo |bold italic underline strikethrough | blocks fontfamily fontsize |  spellcheckdialog a11ycheck typography uploadcare | numlist bullist indent outdent |',
            tinycomments_mode: 'embedded',
            tinycomments_author: 'Author name',
            mergetags_list: [
                { value: 'First.Name', title: 'First Name' },
                { value: 'Email', title: 'Email' },
            ],
            tinymceai_token_provider: async () => {
                await fetch(`https://demo.api.tiny.cloud/1/yu2fuakzhixci1g9b09y8g8o4ka1v1trmjc7lquf3z0kbk2f/auth/random`, { method: "POST", credentials: "include" });
                return { token: await fetch(`https://demo.api.tiny.cloud/1/yu2fuakzhixci1g9b09y8g8o4ka1v1trmjc7lquf3z0kbk2f/jwt/tinymceai`, { credentials: "include" }).then(r => r.text()) };
            },
            uploadcare_public_key: 'de4f1c619c79d544888b',
        });
    </script>
}
