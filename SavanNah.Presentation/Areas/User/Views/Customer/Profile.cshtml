@model UserVM

@{
    var displayName = string.IsNullOrWhiteSpace(Model.Name) ? "Customer" : Model.Name.Trim();
    var email = string.IsNullOrWhiteSpace(Model.Email) ? "No email address available" : Model.Email.Trim();
    var role = string.IsNullOrWhiteSpace(Model.Role) ? "Customer" : Model.Role.Trim();
    var initials = displayName[0].ToString().ToUpperInvariant();
    ViewData["Title"] = $"{displayName} — Profile";
}

<div class="sv-page-header">
    <div>
        <span class="sv-label-micro" style="color: var(--sv-light-text-muted); display: block; margin-bottom: 0.25rem;">
            <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle;">badge</span>
            My Account
        </span>
        <h1 class="sv-page-title">Profile</h1>
        <p style="color: var(--sv-light-text-muted); font-size: 14px; margin: 0.25rem 0 0;">Manage your SavanNah account details.</p>
    </div>
</div>

<div style="background: var(--sv-light-surface); border: 1px solid var(--sv-light-border);">
    <div style="padding: 2rem;">
        <div class="row align-items-center g-4">
            <!-- Avatar Section -->
            <div class="col-md-4 text-center">
                <div style="width: 80px; height: 80px; background: var(--sv-primary); color: var(--sv-text-primary); display: inline-flex; align-items: center; justify-content: center; font-family: var(--sv-font-display); font-size: 28px; font-weight: 700; letter-spacing: 0.08em; margin-bottom: 1rem;">
                    @initials
                </div>
                <h2 style="font-family: var(--sv-font-display); font-size: 20px; font-weight: 700; margin-bottom: 0.25rem;">@displayName</h2>
                <p style="color: var(--sv-light-text-muted); font-size: 14px; word-break: break-all; margin-bottom: 0.75rem;">@email</p>
                <span class="badge" style="background: var(--sv-primary); color: var(--sv-text-primary); padding: 6px 14px;">
                    <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle; margin-right: 0.25rem;">verified_user</span>
                    @role
                </span>
                <div style="margin-top: 1.5rem;">
                    <a asp-area="User" asp-controller="Product" asp-action="Index" class="btn-sv-primary" style="width: 100%; height: 40px; font-size: 12px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">shopping_bag</span>
                        Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Details Section -->
            <div class="col-md-8">
                <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--sv-light-border); padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
                    <h3 style="font-family: var(--sv-font-display); font-size: 16px; font-weight: 600; margin: 0;">Account Details</h3>
                    <span class="material-symbols-outlined" style="font-size: 20px; color: var(--sv-green);">check_circle</span>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div style="border: 1px solid var(--sv-light-border); padding: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
                            <span style="width: 36px; height: 36px; background: var(--sv-primary); color: var(--sv-text-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">person</span>
                            </span>
                            <div>
                                <div class="sv-label-micro" style="color: var(--sv-light-text-muted); font-size: 10px;">Full Name</div>
                                <div style="font-weight: 600; font-size: 14px;">@displayName</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div style="border: 1px solid var(--sv-light-border); padding: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
                            <span style="width: 36px; height: 36px; background: var(--sv-primary); color: var(--sv-text-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">mail</span>
                            </span>
                            <div style="min-width: 0;">
                                <div class="sv-label-micro" style="color: var(--sv-light-text-muted); font-size: 10px;">Email</div>
                                <div style="font-weight: 600; font-size: 14px; overflow: hidden; text-overflow: ellipsis;">@email</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div style="border: 1px solid var(--sv-light-border); padding: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
                            <span style="width: 36px; height: 36px; background: var(--sv-primary); color: var(--sv-text-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">id_card</span>
                            </span>
                            <div>
                                <div class="sv-label-micro" style="color: var(--sv-light-text-muted); font-size: 10px;">Member Role</div>
                                <div style="font-weight: 600; font-size: 14px;">@role</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="border-top: 1px solid var(--sv-light-border); margin-top: 1.25rem; padding-top: 1.25rem;">
                    <div class="sv-label-micro" style="color: var(--sv-light-text-muted); font-size: 10px; margin-bottom: 0.75rem;">Explore SavanNah</div>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                        <a asp-area="User" asp-controller="Product" asp-action="Index" class="btn-sv-secondary" style="height: 36px; font-size: 12px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">grid_view</span>
                            Browse Products
                        </a>
                        <a asp-area="User" asp-controller="Category" asp-action="Index" class="btn-sv-secondary" style="height: 36px; font-size: 12px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">sell</span>
                            View Categories
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
