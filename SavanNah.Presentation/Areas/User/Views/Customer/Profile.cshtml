@model UserVM

@{
	var displayName = string.IsNullOrWhiteSpace(Model.Name) ? "Customer" : Model.Name.Trim();
	var email = string.IsNullOrWhiteSpace(Model.Email) ? "No email address available" : Model.Email.Trim();
	var role = string.IsNullOrWhiteSpace(Model.Role) ? "Customer" : Model.Role.Trim();
	var initials = displayName[0].ToString().ToUpperInvariant();

	ViewData["Title"] = $"{displayName} Profile";
}

<style>
	.profile-black {
		background-color: #000;
		color: #fff;
	}

	.profile-black:hover,
	.profile-black:focus {
		background-color: #000;
		color: #fff;
	}

	.profile-avatar {
		width: 5rem;
		height: 5rem;
		letter-spacing: 0.08em;
	}

	.profile-info-icon {
		width: 2.25rem;
		height: 2.25rem;
		flex: 0 0 auto;
	}
</style>

	<div class="profile-page pb-2">
		<div class="d-flex align-items-center justify-content-between gap-3 mb-3">
			<div>
				<div class="small fw-semibold text-uppercase text-body-secondary mb-1">
					<i class="bi bi-person-badge me-2" aria-hidden="true"></i>My account
				</div>
				<h1 class="h2 fw-bold mb-1">Profile</h1>
				<p class="text-body-secondary mb-0">Manage your SavanNah account details.</p>
			</div>
			<i class="bi bi-person-circle d-none d-sm-block display-5 text-black" aria-hidden="true"></i>
		</div>

		<section class="card border-0 shadow-sm">
			<div class="card-body p-3 p-md-4">
				<div class="row align-items-center g-4">
					<div class="col-md-5 text-center">
						<div class="profile-avatar profile-black d-inline-flex align-items-center justify-content-center rounded-circle fs-2 fw-semibold mb-3">
							@initials
						</div>

						<h2 class="h4 fw-bold mb-1">@displayName</h2>
						<p class="text-body-secondary text-break mb-2">@email</p>
						<span class="badge rounded-pill profile-black px-3 py-2">
							<i class="bi bi-person-check me-1" aria-hidden="true"></i>@role
						</span>

						<a asp-area="User" asp-controller="Product" asp-action="Index" class="btn profile-black w-100 mt-3">
							<i class="bi bi-bag me-2" aria-hidden="true"></i>Continue shopping
						</a>
					</div>

					<div class="col-md-7">
						<div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
							<h2 class="h5 fw-bold mb-0">Account details</h2>
							<i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i>
						</div>

						<div class="row g-2">
							<div class="col-sm-6">
								<div class="h-100 border rounded-3 p-2">
									<div class="d-flex align-items-center gap-2">
										<span class="profile-info-icon profile-black d-inline-flex align-items-center justify-content-center rounded-3">
											<i class="bi bi-person" aria-hidden="true"></i>
										</span>
										<div class="min-w-0">
											<div class="small text-uppercase text-body-secondary fw-semibold">Full name</div>
											<div class="fw-semibold text-break">@displayName</div>
										</div>
									</div>
								</div>
							</div>

							<div class="col-sm-6">
								<div class="h-100 border rounded-3 p-2">
									<div class="d-flex align-items-center gap-2">
										<span class="profile-info-icon profile-black d-inline-flex align-items-center justify-content-center rounded-3">
											<i class="bi bi-envelope-at" aria-hidden="true"></i>
										</span>
										<div class="min-w-0">
											<div class="small text-uppercase text-body-secondary fw-semibold">Email</div>
											<div class="fw-semibold text-break">@email</div>
										</div>
									</div>
								</div>
							</div>

							<div class="col-sm-6">
								<div class="h-100 border rounded-3 p-2">
									<div class="d-flex align-items-center gap-2">
										<span class="profile-info-icon profile-black d-inline-flex align-items-center justify-content-center rounded-3">
											<i class="bi bi-person-vcard" aria-hidden="true"></i>
										</span>
										<div class="min-w-0">
											<div class="small text-uppercase text-body-secondary fw-semibold">Member role</div>
											<div class="fw-semibold text-break">@role</div>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="border-top mt-3 pt-3">
							<div class="small text-uppercase text-body-secondary fw-semibold mb-2">Explore SavanNah</div>
							<div class="d-flex flex-wrap gap-2">
								<a asp-area="User" asp-controller="Product" asp-action="Index" class="btn profile-black btn-sm">
									<i class="bi bi-grid me-2" aria-hidden="true"></i>Browse products
								</a>
								<a asp-area="User" asp-controller="Category" asp-action="Index" class="btn btn-outline-dark btn-sm">
									<i class="bi bi-tags me-2" aria-hidden="true"></i>View categories
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
</div>
