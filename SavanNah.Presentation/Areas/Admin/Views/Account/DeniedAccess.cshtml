@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 mt-5 text-center">
            <h1 class="text-danger fw-bold display-1">403</h1>
            <h2 class="mb-4">Access Denied</h2>
            <p class="mb-5 text-muted lead">
                Sorry, you do not have permission to access this page or perform this action. 
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <button type="button" onclick="history.back()" class="px-4 btn btn-outline-secondary btn-lg">
                    Go Back
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="px-4 btn btn-primary btn-lg">
                    Go to Home
                </a>
            </div>
        </div>
    </div>
</div>
