@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center mt-5">
            <h1 class="display-1 text-danger fw-bold">403</h1>
            <h2 class="mb-4">Access Denied</h2>
            <p class="lead mb-5 text-muted">
                Sorry, you do not have permission to access this page or perform this action. 
            </p>
            <div class="d-flex justify-content-center gap-3">
                <button type="button" onclick="history.back()" class="btn btn-outline-secondary btn-lg px-4">
                    Go Back
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                    Go to Home
                </a>
            </div>
        </div>
    </div>
</div>
