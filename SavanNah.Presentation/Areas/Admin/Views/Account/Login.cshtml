@model LoginActionRequest

@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="sv-auth-page">
    <div class="sv-content" style="margin-top: 0;">
        <!-- Brand Header -->
        <div class="sv-auth-header">
            <a asp-area="User" asp-controller="Home" asp-action="Index" style="text-decoration: none;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 40" fill="none" style="height: 36px; width: auto;">
                    <g transform="translate(4, 6)">
                        <circle cx="14" cy="14" r="13" stroke="#E07A5F" stroke-width="2" fill="none" opacity="0.4"/>
                        <path d="M14 6 C9 12 8 18 14 22 C20 18 19 12 14 6Z" fill="#E07A5F"/>
                        <path d="M7 16 C11 15 17 15 21 16" stroke="#1A1F16" stroke-width="1.5" stroke-linecap="round"/>
                        <circle cx="14" cy="14" r="2.5" fill="#1A1F16"/>
                    </g>
                    <text x="42" y="26" font-family="'Space Grotesk', sans-serif" font-weight="700" font-size="20" letter-spacing="1.5" fill="#1A1F16">SAVANNAH</text>
                    <circle cx="168" cy="18" r="2.5" fill="#E07A5F"/>
                </svg>
            </a>
            <h1>Welcome Back</h1>
            <p>Enter your credentials to access your account</p>
        </div>

        <!-- Login Card -->
        <div class="sv-auth-card">
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--sv-light-border); padding-bottom: 1.25rem; margin-bottom: 1.5rem;">
                <div>
                    <span class="sv-label-micro" style="color: var(--sv-terracotta); display: block; margin-bottom: 0.25rem; font-size: 10px;">Access Gate</span>
                    <span style="font-family: var(--sv-font-display); font-size: 18px; font-weight: 700; color: var(--sv-light-text);">Sign In to Savannah</span>
                </div>
                <div style="width: 40px; height: 40px; background: var(--sv-light-bg-alt); border: 1px solid var(--sv-light-border); display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined" style="color: var(--sv-terracotta); font-size: 20px;">key</span>
                </div>
            </div>

            <form method="post" action="@Url.Action("Login", "Account", new { area = "Admin" })" novalidate>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" style="color: var(--sv-red); font-size: 13px; margin-bottom: 1rem; padding: 0.75rem; border: 1px solid var(--sv-red); background: rgba(220, 38, 38, 0.05);"></div>
                }

                <!-- Email -->
                <div style="margin-bottom: 1.25rem;">
                    <label for="Email" class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="Email" name="Email"
                           placeholder="your@email.com" value="@Model?.Email" required/>
                    <span asp-validation-for="Email" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <!-- Password -->
                <div style="margin-bottom: 1.25rem;">
                    <label for="Password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="Password" name="Password"
                           placeholder="••••••••••••" required/>
                    <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <!-- Remember Me -->
                <div style="margin-bottom: 1.5rem;">
                    <label style="display: flex; align-items: center; cursor: pointer;">
                        <input type="checkbox" class="form-check-input" id="RememberMe" name="RememberMe" value="true" style="margin-right: 0.75rem;"/>
                        <span style="font-size: 13px; color: var(--sv-light-text-muted);">Remember this device</span>
                    </label>
                </div>

                <input type="hidden" value="@ViewBag.ReturnUrl" name="returnUrl"/>

                <!-- Submit -->
                <button type="submit" class="btn-sv-primary" style="width: 100%; height: 48px; font-size: 14px;">
                    Sign In
                    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                </button>

                <!-- Register Link -->
                <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--sv-light-border);">
                    <span style="font-size: 13px; color: var(--sv-light-text-muted);">
                        Don't have an account?
                        <a href="@Url.Action("Register", "Account", new { area = "Admin" })" style="color: var(--sv-terracotta); text-decoration: none; font-weight: 600;">
                            Create one here
                        </a>
                    </span>
                </div>
            </form>
        </div>
    </div>
</div>
