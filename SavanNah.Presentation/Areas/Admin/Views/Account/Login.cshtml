@model LoginActionRequest

@{
    ViewData["Title"] = "Login";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="w-100" style="max-width: 450px;">
        <div class="card shadow border-0 rounded-lg">
            <div class="card-body p-5">
                <!-- Header -->
                <div class="text-center mb-4">
                    <h1 class="h3 font-weight-bold text-dark mb-2">Login</h1>
                    <p class="text-muted mb-0">Welcome back! Please log in to your account</p>
                </div>

                <form method="post" action="@Url.Action("Login", "Account", new { area = "Admin" })" novalidate>
                    <!-- Validation Errors -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="text-danger"></div>
                    }

                    <!-- Email Field -->
                    <div class="mb-3">
                        <label for="Email" class="form-label fw-bold">Email Address</label>
                        <input type="email"
                               class="form-control form-control-lg"
                               id="Email"
                               name="Email"
                               placeholder="Enter your email"
                               value="@Model?.Email"
                               required>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <label for="Password" class="form-label fw-bold">Password</label>
                        <input type="password"
                               class="form-control form-control-lg"
                               id="Password"
                               name="Password"
                               placeholder="Enter your password"
                               required>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Remember Me Checkbox -->
                    <div class="form-check mb-3">
                        <input type="checkbox"
                               class="form-check-input"
                               id="RememberMe"
                               name="RememberMe"
                               value="true">
                        <label class="form-check-label" for="RememberMe">
                            Remember me
                        </label>
                    </div>


                    <input type="hidden" value="@ViewBag.ReturnUrl" name="returnUrl"/>
                    <!-- Login Button -->
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold mb-3">Sign In</button>

                    <!-- Sign Up Link -->
                    <div class="text-center">
                        <small class="text-muted">
                            Don't have an account? 
                            <a href="@Url.Action("Register", "Account", new { area = "Admin" })" class="text-decoration-none fw-semibold">Sign up here</a>
                        </small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
