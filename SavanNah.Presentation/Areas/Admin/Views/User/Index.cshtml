@model List<UserVM>

@{
    ViewData["Title"] = "Users";
    Layout = "_admin";
}

<div class="d-flex mb-4 mt-2 justify-content-between align-items-center">
    <h1>Users</h1>
    <a class="btn btn-success" asp-area="Admin" asp-controller="User" asp-action="Create">
        @* <a class="btn btn-success" asp-area="Admin" asp-controller="Account" asp-action="Register"> *@
        <i class="bi bi-plus-circle"></i> Create new User
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th></th>

        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td class="align-middle"style="width:340px;">@user.Id</td>
                <td class="align-middle">@user.Name</td>
                <td class="align-middle" style="width: 200px ;">@user.Email</td>
                <td class="align-middle">@user.Role</td>
                <td class="align-middle">
                    <form method="post" asp-area="Admin" asp-controller="User" asp-action="Delete" enctype="application/x-www-form-urlencoded" novalidate>
                        <input type="hidden" name="id" value='@user.Id'>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash3-fill"></i>
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>