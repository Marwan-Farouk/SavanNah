@model List<Role>

@{
    ViewData["Title"] = "Index";
    Layout = "_admin";
}

<style>
    a,
    button,
    input[type='submit'] {
        height: 100% !important;
    }
    h1, h2, h3, h4, th {
        color: var(--sv-text-primary) !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center">

    <h1 class="text-light">Roles</h1>
    <div>
        <a class="btn btn-success h-100" asp-area="Admin" asp-controller="Role" asp-action="Create">
            <i class="bi bi-plus-circle "></i>
            Create new Role
        </a>
        <a class="btn btn-primary h-100" asp-area="Admin" asp-controller="Role" asp-action="AssignRole">
            <i class="bi bi-pencil-square"></i>
            Assign Roles
        </a>
    </div>
</div>

<div class="mt-4 table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
        <tr>
            <th>Role Name</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td class="align-middle">@role.Name</td>
            </tr>
        }
        </tbody>
    </table>
</div>