@model Role
@{
    ViewData["Title"] = "Create";
    Layout = "_admin";
}

<style>
    a,
    button,
    input[type='submit'] {
        height: 100% !important;
    }
</style>

<div class="row mt-4">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0 text-light">Create Role</h3>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Role" asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="mb-3 text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input type="text" asp-for="Name" class="form-control h-100" placeholder="Enter role name">
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="d-flex mt-4 justify-content-between">
                        <a class="btn btn-secondary h-100" asp-action="Index">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button class="btn btn-success h-100" type="submit">
                            <i class="bi bi-plus-circle"></i> Create
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial");
}