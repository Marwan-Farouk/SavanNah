@model Category
<style>
    input[type='submit'],
    a {
        height: 100% !important;
    }
</style>

<form asp-action="Create" asp-controller="Category" method="post" enctype="multipart/form-data">
    <div class="p-3 border mt4">
        <div class="row pb-2">
            <h2 class="text-light">Create Category</h2>
            <hr>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="p-0 mb-1 form-label"></label>
                <input class="form-control" asp-for="Name"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="p-0 mb-1 form-label"></label>
                <textArea asp-for="Description" class="form-control" ></textArea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="row ">
            <div class="col-6 col-md-3">
                <input type="submit" class="btn btn-primary form-control"/>
            </div>
            <div class="col-6 col-md-3">
                <a class="btn btn-outline-danger form-control" asp-controller="Category" asp-action="Index">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial");
}