@model List<Category>
<link rel="stylesheet" href="~/css/Category/Admin/index.css"/>

<style>
    a,
    button,
    input[type='submit'] {
        height: 100% !important;
    }

    h1, h2, h3, h4, tr>th>h4 {
        --bs-text-opacity: 1;
        color: var(--sv-text-primary) !important;
    }
</style>

<div class="col-12 d-flex w-75 justify-content-between align-items-center header-container">
    <h1 class="col-6 col-md-4 text-light">Categories</h1>
    <a class="col-5 col-sm-3 btn btn-success h-100" asp-action="Create" asp-controller="Category">
        <i class="bi bi-plus-circle"></i>
        Add Categories
    </a>
</div>

<div class="table-container w-75">
    <table class="table table-hover table-bordered">
        <thead class="table-active">
        <tr>
            <th>
                <h4>Category</h4>
            </th>
            <th>
                <h4>Description</h4>
            </th>
            <th></th>
            <th></th>
        </tr>
        </thead>
        <tbody>

        @foreach (var cat in Model)
        {
            <tr>
                <th scope="row">@cat.Name</th>
                <th scope="row">@cat.Description</th>
                <td class="text-center">
                    <a asp-area="Admin" asp-controller="Category" asp-action="Edit" class="btn btn-primary h-100" asp-route-id="@cat.Id">
                        <i class="bi bi-pencil-square"></i>
                        Edit
                    </a>
                </td>
                <td class="text-center">
                    <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@cat.Id" method="post">
                        <button type="submit" class="btn btn-danger h-100 del-btn">
                            <i class="bi bi-trash3"></i>
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>

    </table>

</div>

