@model List<SavanNah.Models.Models.OrderModel.Order>

@{
    ViewData["Title"] = "Orders";
}

<style>
    th,
    td {
        text-align: center !important;
    }

    a,
    button,
    input[type='submit'] {
        height: 100% !important;
    }

    h1,
    h2,
    h3,
    h4,
    th {
        color: var(--sv-text-primary) !important;
    }
</style>

<div class="d-flex mb-4 justify-content-between align-items-center">
    <h2 class="mb-0 text-light">Orders</h2>
</div>

<table id="orderTable"
       class="table table-bordered table-hover w-100"
       style="width:100%">
    <thead style="width:100%">
    <tr>
        <th scope="col">Order ID</th>
        <th scope="col" style="width: 10%;">Customer</th>
        <th scope="col">Order Date</th>
        <th scope="col">Status</th>
        <th scope="col" style="width: 15%;">Total Amount</th>
    </tr>
    </thead>
    <tbody class="table-hover table-bordered"></tbody>
</table>


@section Scripts {
    <script src="~/js/Order/OrderIndex.js"></script>

}