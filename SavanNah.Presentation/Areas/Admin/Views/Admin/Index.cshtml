@{
    ViewData["Title"] = "Dashboard";
    Layout = "_admin";
}

<div style="margin-bottom: 2rem;">
    <h1 style="font-family: var(--sv-font-display); font-size: 28px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.25rem;">Dashboard</h1>
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item active">Overview</li>
    </ol>
</div>

<div class="row g-4">
    <!-- Users -->
    <div class="col-xl-3 col-md-6">
        <div class="sv-metric-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="sv-metric-label">User Configuration</div>
                    <div class="sv-metric-value">Users</div>
                </div>
                <i class="bi bi-person-fill" style="font-size: 28px; color: var(--sv-text-muted); opacity: 0.4;"></i>
            </div>
            <a class="sv-metric-link" asp-controller="User" asp-action="Index">
                View Details <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
            </a>
        </div>
    </div>

    <!-- Roles -->
    <div class="col-xl-3 col-md-6">
        <div class="sv-metric-card amber">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="sv-metric-label">User Configuration</div>
                    <div class="sv-metric-value">Roles</div>
                </div>
                <i class="bi bi-sliders2" style="font-size: 28px; color: var(--sv-text-muted); opacity: 0.4;"></i>
            </div>
            <a class="sv-metric-link" asp-controller="Role" asp-action="Index">
                View Details <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
            </a>
        </div>
    </div>

    <!-- Products -->
    <div class="col-xl-3 col-md-6">
        <div class="sv-metric-card green">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="sv-metric-label">Management</div>
                    <div class="sv-metric-value">Products</div>
                </div>
                <i class="bi bi-bag-fill" style="font-size: 28px; color: var(--sv-text-muted); opacity: 0.4;"></i>
            </div>
            <a class="sv-metric-link" asp-area="Admin" asp-controller="Product" asp-action="Index">
                View Details <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
            </a>
        </div>
    </div>

    <!-- Categories -->
    <div class="col-xl-3 col-md-6">
        <div class="sv-metric-card red">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="sv-metric-label">Management</div>
                    <div class="sv-metric-value">Categories</div>
                </div>
                <i class="bi bi-shop" style="font-size: 28px; color: var(--sv-text-muted); opacity: 0.4;"></i>
            </div>
            <a class="sv-metric-link" asp-area="Admin" asp-controller="Category" asp-action="Index">
                View Details <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
            </a>
        </div>
    </div>

    <!-- Brands -->
    <div class="col-xl-3 col-md-6">
        <div class="sv-metric-card" style="border-top-color: #0EA5E9;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="sv-metric-label">Management</div>
                    <div class="sv-metric-value">Brands</div>
                </div>
                <i class="bi bi-award-fill" style="font-size: 28px; color: var(--sv-text-muted); opacity: 0.4;"></i>
            </div>
            <a class="sv-metric-link" asp-area="Admin" asp-controller="Brand" asp-action="Index">
                View Details <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
            </a>
        </div>
    </div>

    <!-- Orders -->
    <div class="col-xl-3 col-md-6">
        <div class="sv-metric-card" style="border-top-color: var(--sv-text-muted);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="sv-metric-label">Management</div>
                    <div class="sv-metric-value">Orders</div>
                </div>
                <i class="bi bi-receipt" style="font-size: 28px; color: var(--sv-text-muted); opacity: 0.4;"></i>
            </div>
            <a class="sv-metric-link" asp-area="Admin" asp-controller="Order" asp-action="Index">
                View Details <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
            </a>
        </div>
    </div>

    <!-- Payments -->
    <div class="col-xl-3 col-md-6">
        <div class="sv-metric-card" style="border-top-color: var(--sv-text-primary);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="sv-metric-label">Management</div>
                    <div class="sv-metric-value">Payments</div>
                </div>
                <i class="bi bi-credit-card-fill" style="font-size: 28px; color: var(--sv-text-muted); opacity: 0.4;"></i>
            </div>
            <a class="sv-metric-link" asp-area="Admin" asp-controller="Payment" asp-action="Index">
                View Details <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
            </a>
        </div>
    </div>
</div>
