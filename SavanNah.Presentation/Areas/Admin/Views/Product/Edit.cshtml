@{
    ViewData["Title"] = "Edit Product";
}
@model ProductVM

<link rel="stylesheet" href="~/css/product/Admin/product-form.css" asp-append-version="true"/>


<style>
    a,
    button,
    input[type='submit'] {
        height: 100% !important;
    }
</style>

<div class="d-flex mb-4 justify-content-between align-items-center">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="mb-1 breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="User" asp-controller="Product" asp-action="Index" class="text-decoration-none">Products</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h2 class="mb-0 fw-bold text-light">Edit Product</h2>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card create-card">
            <div class="card-header">
                <div class="d-flex gap-3 align-items-center">
                    <div class="p-2 bg-white bg-opacity-10 rounded-circle">
                        <i class="text-white fs-4 bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 text-white fw-bold">Product Details</h5>
                        <small class="text-white-50">Update the information below to edit the product</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <form asp-area="Admin" asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()

                    @* Hidden ID field to identify the product being edited *@
                    <input asp-for="Product.Id" type="hidden"/>
                    <input asp-for="Product.Image" type="hidden" value="@Model.Product.Image"/>
                    @* Global validation summary *@
                    <div asp-validation-summary="All" class="py-2 alert alert-danger rounded-3"></div>

                    @* — Basic Info — *@
                    <p class="section-divider">
                        <i class="me-1 bi bi-info-circle"></i> Basic Information
                    </p>

                    <div class="mb-3">
                        <label asp-for="Product.Name" class="form-label">
                            <i class="me-1 text-muted bi bi-tag"></i> Product Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Product.Name" id="Name" class="form-control" placeholder="e.g. Running Shoes Pro X" autocomplete="off"/>
                        <span asp-validation-for="Product.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label">
                            <i class="me-1 text-muted bi bi-card-text"></i> Description
                        </label>
                        <textarea asp-for="Product.Description" id="Description" class="form-control" rows="3"
                                  placeholder="Write a short product description…" maxlength="1000"></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="Product.Description" class="text-danger small"></span>
                            <small class="text-muted ms-auto" id="desc-counter">0 / 1000</small>
                        </div>
                    </div>

                    @* — Pricing — *@
                    <p class="mt-4 section-divider">
                        <i class="me-1 bi bi-currency-dollar"></i> Pricing
                    </p>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Product.Price" class="form-label">
                                Price <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Product.Price" id="Price" type="number" step="0.01" min="0.01" max="999999.99" class="form-control" placeholder="0.00"/>
                            </div>
                            <span asp-validation-for="Product.Price" class="text-danger small"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="Product.Discount" class="form-label">
                                Discount (%)
                            </label>
                            <div class="input-group">
                                <input asp-for="Product.Discount" id="Discount" type="number" step="0.01" min="0" max="100"
                                       class="form-control" placeholder="0"/>
                                <span class="input-group-text" style="border-radius:0 10px 10px 0; border-left:none;">%</span>
                            </div>
                            <span asp-validation-for="Product.Discount" class="text-danger small"></span>
                        </div>
                    </div>

                    @* — Classification — *@
                    <p class="mt-4 section-divider">
                        <i class="me-1 bi bi-diagram-3"></i> Classification
                    </p>

                    <div class="mb-3">
                        <label asp-for="Product.BrandId" class="form-label">
                            <i class="me-1 text-muted bi bi-award"></i> Brand <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Product.BrandId" id="BrandId" asp-items="Model.Brands" class="form-select">
                            <option value="" disabled>— Select a brand —</option>
                        </select>
                        <span asp-validation-for="Product.BrandId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryIds" class="form-label">
                            <i class="me-1 text-muted bi bi-grid"></i> Categories <span class="text-danger">*</span>
                        </label>
                        <select asp-for="CategoryIds" asp-items="@Model.Categories" class="form-select" id="CategoryIds" multiple></select>
                    </div>

                    @* — Image Preview — *@
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="me-1 text-muted bi bi-image"></i> Image
                        </label>
                        <div>
                            <input type="file" name="file" class="form-control" id="Image">
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model?.Product?.Image))
                        {
                            <div class="mt-2">
                                <img src="@Url.Content("~/" + Model.Product.Image)" alt="Product image" class="img-fluid img-thumbnail" style="max-width:240px;"/>
                            </div>
                        }
                        else
                        {
                            <div class="mt-2 text-muted">No image available for this product.</div>
                        }
                    </div>

                    @* — Actions — *@
                    <div class="d-flex gap-2 pt-2 justify-content-end border-top">
                        <a id="btn-cancel" asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary h-100">
                            <i class="me-1 bi bi-x-circle"></i> Cancel
                        </a>
                        <button id="btn-save" type="submit" class="btn btn-primary h-100">
                            <i class="me-1 bi bi-floppy"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script>
        tinymce.init({
            selector: 'textarea',
            plugins: [
                // Core editing features
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount',
                // Premium features
            ],
            toolbar: 'undo redo |bold italic underline strikethrough | blocks fontfamily fontsize |  spellcheckdialog a11ycheck typography uploadcare | numlist bullist indent outdent |',
            tinycomments_mode: 'embedded',
            tinycomments_author: 'Author name',
            mergetags_list: [
                { value: 'First.Name', title: 'First Name' },
                { value: 'Email', title: 'Email' },
            ],
            tinymceai_token_provider: async () => {
                await fetch(`https://demo.api.tiny.cloud/1/yu2fuakzhixci1g9b09y8g8o4ka1v1trmjc7lquf3z0kbk2f/auth/random`, { method: "POST", credentials: "include" });
                return { token: await fetch(`https://demo.api.tiny.cloud/1/yu2fuakzhixci1g9b09y8g8o4ka1v1trmjc7lquf3z0kbk2f/jwt/tinymceai`, { credentials: "include" }).then(r => r.text()) };
            },
            uploadcare_public_key: 'de4f1c619c79d544888b',
        });
    </script>
}
