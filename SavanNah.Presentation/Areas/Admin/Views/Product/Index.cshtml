@{
    ViewData["Title"] = "Products";
}
@model List<Product>

<style>
    label {
        margin-left: 10px;
    }
    a,
    button,
    input[type='submit'] {
        height: 100% !important;
    }
    h1, h2, h3, h4, th {
        color: var(--sv-text-primary) !important;
    }
</style>

<div class="d-flex mb-4 justify-content-between align-items-center">
    <h2 class="mb-0 text-light">Products</h2>
    <div class="d-flex gap-2 justify-content-end align-items-center">
        <span class="badge bg-secondary fs-6">@Model.Count item@(Model.Count != 1 ? "s" : "")</span>
        <a class="btn btn-success h-100" asp-area="User" asp-controller="Product" asp-action="Create">
            <i class="bi bi-plus-circle "></i>
            Add Product
        </a>
    </div>
    @* <div>
        <form asp-controller="Product" asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search"/>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div> *@
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No products found.</div>
}
else
{
    <table id="myTable" class="table table-bordered table-hover" style="width:100%;">
        <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Discount</th>
            <th>Brand</th>
            <th>Category</th>
            <th></th>
        </tr>
        </thead>
    </table>
    <div class="d-flex justify-content-center partial-container" style="width: 100%;">

    </div>
}

@section Scripts
{
    <script type="text/javascript" src="~/js/Product/Admin/index.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
