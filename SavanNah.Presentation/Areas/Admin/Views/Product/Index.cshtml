@{
    ViewData["Title"] = "Products";
}
@model List<Product>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Products</h2>
    <div class="d-flex gap-2 justify-content-end align-items-center">
        <span class="badge bg-secondary fs-6">@Model.Count item@(Model.Count != 1 ? "s" : "")</span>
        <a class="btn btn-success" asp-area="User" asp-controller="Product" asp-action="Create">
            <i class="bi bi-plus-circle "></i>
            Add Product
        </a>
    </div>
    @* <div>
        <form asp-controller="Product" asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search"/>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div> *@
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No products found.</div>
}
else
{
    <table id="myTable" class="table table-bordered table-hover" style="width:100%;">
        <thead class="thead-dark">
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Discount</th>
            <th>Brand</th>
            <th>Category</th>
            <th></th>
        </tr>
        </thead>
    </table>
    <div class="partial-container d-flex justify-content-center" style="width: 100%;">

    </div>
}

@section Scripts
{
    <script type="text/javascript" src="~/js/Product/index.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
