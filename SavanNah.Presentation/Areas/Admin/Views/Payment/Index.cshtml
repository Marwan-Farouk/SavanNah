@model List<SavanNah.Models.Models.PaymentModel.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Payments</h2>
</div>

<table id="paymentTable"
       class="table table-bordered table-hover w-100">
    <thead class="table-bordered table-primary table-active">
        <tr>
            <th scope="col">Payment ID</th>
            <th scope="col">Customer</th>
            <th scope="col">Order ID</th>
            <th scope="col">Payment Date</th>
        </tr>
    </thead>
    <tbody class="table-hover table-bordered"></tbody>
</table>

@section Scripts {
    <script src="~/js/Payment/PaymentIndex.js"></script>
}
