<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
    <meta name="description" content=""/>
    <meta name="author" content=""/>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true"/>

    <link
        href="/css/admin.css"
        rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous">
    <link href="https://cdn.datatables.net/3.0.3/css/dataTables.dataTables.min.css" rel="stylesheet">

</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark sb-topnav">
    <!-- Navbar Brand-->
    <a class="ps-3 navbar-brand" asp-controller="Admin" asp-action="Index">Admin</a>
    <!-- Sidebar Toggle-->
    <button
        class="order-1 order-lg-0 me-4 me-lg-0 btn btn-link btn-sm"
        id="sidebarToggle"
        href="#!">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Navbar Search-->
    @* <form
        class="d-none d-md-inline-block me-0 me-md-3 my-2 my-md-0 form-inline ms-auto">
        <div class="input-group">
            <input
                class="form-control"
                type="text"
                placeholder="Search for..."
                aria-label="Search for..."
                aria-describedby="btnNavbarSearch"/>
            <button
                class="btn btn-primary"
                id="btnNavbarSearch"
                type="button">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </form>*@
    <!-- Navbar-->
    <ul class="ms-md-0 me-3 me-lg-4 navbar-nav ms-auto justify-content-end w-100">
        <li class="nav-item">
            <a
                class="nav-link fs-5"
                id="navbarDropdown"
                role="button"
                asp-area="User" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door-fill"></i>
                <span>
                    Home
                </span>
            </a>

        </li>
    </ul>
</nav>
<div id="layoutSidenav">
    <div id="layoutSidenav_nav">
        <nav
            class="accordion sb-sidenav sb-sidenav-dark"
            id="sidenavAccordion">
            <div class="sb-sidenav-menu">
                <div class="nav">
                    <div class="sb-sidenav-menu-heading">Core</div>
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                        <div class="sb-nav-link-icon">
                            <i class="fas fa-tachometer-alt"></i>
                        </div>
                        Dashboard
                    </a>
                    <div class="sb-sidenav-menu-heading">User Configuration</div>
                    <a class="nav-link" asp-controller="User" asp-action="Index">
                        <div class="sb-nav-link-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        Users
                    </a>
                    <a class="nav-link" asp-controller="Role" asp-action="Index">
                        <div class="sb-nav-link-icon">
                            <i class="bi bi-sliders2"></i>
                        </div>
                        Roles
                    </a>
                    <div class="sb-sidenav-menu-heading">Management</div>
                    <a class="nav-link" asp-area="Admin" asp-controller="Product" asp-action="Index">
                        <div class="sb-nav-link-icon">
                            <i class="bi bi-bag-fill"></i>
                        </div>
                        Products
                    </a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <div class="sb-nav-link-icon">
                            <i class="bi bi-shop"></i>
                        </div>
                        Categories
                    </a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Brand" asp-action="Index">
                        <div class="sb-nav-link-icon">
                            <i class="bi bi-alexa"></i>
                        </div>
                        Brands
                    </a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <div class="sb-nav-link-icon">
                            <i class="bi bi-receipt"></i>
                        </div>
                        Orders
                    </a>
                </div>
            </div>
        </nav>
    </div>
    <div id="layoutSidenav_content">
        <main role="main">
            <div class="container-fluid px-4">
                <partial name="_NotificationPartial"/>
                @RenderBody()
            </div>
        </main>
        <footer class="py-4 mt-auto bg-light">
            <div class="container-fluid px-4">
                <div
                    class="d-flex align-items-center justify-content-between small">
                    <div class="text-muted">
                        Copyright &copy; SavanNah 2025
                    </div>
                    <div>
                        <a href="#">Privacy Policy</a>
                        &middot;
                        <a href="#">Terms &amp; Conditions</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="https://cdn.tiny.cloud/1/yu2fuakzhixci1g9b09y8g8o4ka1v1trmjc7lquf3z0kbk2f/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
<script src="https://cdn.datatables.net/3.0.3/js/dataTables.min.js"></script>
<script src="~/js/admin.js"></script>
<script
    src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
    crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
