<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — SAVANNAH</title>
    <meta name="description" content="SavanNah — Architectural provisions and equatorial artisan creations curated for wild horizons."/>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/savannah-favicon.png" asp-append-version="true"/>

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous"/>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/savannah-design-system.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link href="https://cdn.datatables.net/v/dt/dt-3.0.1/datatables.min.css" rel="stylesheet"/>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- Navigation -->
<header class="sv-navbar">
    <div class="sv-navbar-inner">
        <!-- Brand Logo -->
        <a class="sv-brand-logo" asp-area="User" asp-controller="Home" asp-action="Index">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 40" fill="none" style="height: 30px; width: auto;">
                <g transform="translate(4, 6)">
                    <circle cx="14" cy="14" r="13" stroke="#D4A373" stroke-width="2" fill="none" opacity="0.4"/>
                    <path d="M14 6 C9 12 8 18 14 22 C20 18 19 12 14 6Z" fill="#D4A373"/>
                    <path d="M7 16 C11 15 17 15 21 16" stroke="#1A1F16" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="14" cy="14" r="2.5" fill="#1A1F16"/>
                </g>
                <text x="42" y="26" font-family="'Space Grotesk', sans-serif" font-weight="700" font-size="20" letter-spacing="1.5" fill="#1A1F16">SAVANNAH</text>
                <circle cx="168" cy="18" r="2.5" fill="#D4A373"/>
            </svg>
        </a>

        <!-- Navigation Links -->
        <ul class="sv-nav-links" id="navLinks">
            <li>
                <a asp-area="User" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li>
                <a asp-area="User" asp-controller="Product" asp-action="Index">Products</a>
            </li>
            <li>
                <a asp-area="User" asp-controller="Category" asp-action="Index">Categories</a>
            </li>
        </ul>

        <!-- Right Actions -->
        <div class="sv-nav-actions">
            <!-- Cart -->
            <a asp-area="User" asp-controller="Cart" asp-action="Index" title="Cart">
                <span class="material-symbols-outlined" style="font-size: 20px;">shopping_bag</span>
                <span class="sv-cart-badge">Cart</span>
            </a>

            <div class="sv-nav-divider"></div>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- Profile -->
                <a asp-area="User" asp-controller="Customer" asp-action="Profile" title="Profile">
                    <span class="material-symbols-outlined" style="font-size: 20px;">person</span>
                    <span>@User.Identity.Name</span>
                </a>
                <!-- Logout -->
                <a asp-area="Admin" asp-controller="Account" asp-action="Logout" title="Sign Out">
                    <span class="material-symbols-outlined" style="font-size: 18px;">logout</span>
                </a>
            }
            else
            {
                <a asp-area="Admin" asp-controller="Account" asp-action="Login">
                    <span class="material-symbols-outlined" style="font-size: 18px;">login</span>
                    <span>Sign In</span>
                </a>
            }

            <!-- Mobile Toggle -->
            <button class="sv-mobile-toggle" onclick="document.getElementById('navLinks').classList.toggle('show')" aria-label="Toggle navigation">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </div>
</header>

<!-- Main Content -->
<div class="sv-content">
    <partial name="_NotificationPartial"/>
    <main role="main">
        @RenderBody()
    </main>
</div>

<!-- Footer -->
<footer class="sv-footer">
    <div class="sv-footer-inner">
        <div class="sv-footer-grid">
            <!-- Brand Column -->
            <div class="sv-footer-brand">
                <a asp-area="User" asp-controller="Home" asp-action="Index" class="sv-brand-logo" style="opacity: 0.7;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 40" fill="none" style="height: 24px; width: auto;">
                        <g transform="translate(4, 6)">
                            <circle cx="14" cy="14" r="13" stroke="#D4A373" stroke-width="2" fill="none" opacity="0.4"/>
                            <path d="M14 6 C9 12 8 18 14 22 C20 18 19 12 14 6Z" fill="#D4A373"/>
                            <path d="M7 16 C11 15 17 15 21 16" stroke="#FAEDCD" stroke-width="1.5" stroke-linecap="round"/>
                            <circle cx="14" cy="14" r="2.5" fill="#FAEDCD"/>
                        </g>
                        <text x="42" y="26" font-family="'Space Grotesk', sans-serif" font-weight="700" font-size="20" letter-spacing="1.5" fill="#F4F1DE">SAVANNAH</text>
                        <circle cx="168" cy="18" r="2.5" fill="#D4A373"/>
                    </svg>
                </a>
                <p>Architectural provisions and equatorial artisan creations curated for contemplative living and wild horizons.</p>
            </div>

            <!-- Navigation Column -->
            <div>
                <div class="sv-footer-heading">Navigate</div>
                <ul class="sv-footer-links">
                    <li><a asp-area="User" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-area="User" asp-controller="Product" asp-action="Index">All Products</a></li>
                    <li><a asp-area="User" asp-controller="Category" asp-action="Index">Categories</a></li>
                    <li><a asp-area="User" asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                </ul>
            </div>

            <!-- Account Column -->
            <div>
                <div class="sv-footer-heading">Account</div>
                <ul class="sv-footer-links">
                    <li><a asp-area="Admin" asp-controller="Account" asp-action="Login">Sign In</a></li>
                    <li><a asp-area="Admin" asp-controller="Account" asp-action="Register">Create Account</a></li>
                    <li><a asp-area="User" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                </ul>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="sv-footer-bottom">
            <span>&copy; @DateTime.Now.Year SAVANNAH. All rights reserved.</span>
            <div style="display: flex; gap: 1.5rem;">
                <a asp-area="User" asp-controller="Home" asp-action="Privacy" style="color: inherit; text-decoration: none;">Privacy</a>
                <a href="#" style="color: inherit; text-decoration: none;">Terms</a>
            </div>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdn.tiny.cloud/1/yu2fuakzhixci1g9b09y8g8o4ka1v1trmjc7lquf3z0kbk2f/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
<script src="https://cdn.datatables.net/v/dt/dt-3.0.1/datatables.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>