@if (TempData["success"] is not null)
{
    <div class="sv-notification sv-notification-success" id="sv-toast">
        <strong>@TempData["success"]</strong>
    </div>
}

@if (TempData["error"] is not null)
{
    <div class="sv-notification sv-notification-error" id="sv-toast">
        <strong>@TempData["error"]</strong>
    </div>
}